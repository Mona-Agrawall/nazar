# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server only — never prefix with VITE_
SUPABASE_SECRET_KEY=your_secret_key

# true = the app opens without sign-in and the server accepts requests without a token
# (also required for the "Skip for now" button to work)
VITE_DEMO_MODE=false

# Optional: Gemini writes the narratives for high-attention stocks (deterministic text otherwise)
GEMINI_API_KEY=
GEMINI_ENABLED=true

# Optional: "twelve_data" searches symbols via the Twelve Data API instead of the built-in list
MARKET_DATA_PROVIDER=mock
